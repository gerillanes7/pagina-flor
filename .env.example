# ── Autenticación básica del admin (/keystatic) ──────────────────
# Si están definidas, el middleware pide Basic Auth antes de mostrar el panel.
# Si no están definidas, /keystatic devuelve 404.
KEYSTATIC_USER=admin
KEYSTATIC_PASSWORD=cambia-esta-clave

# ── Formulario de contacto (Resend) ───────────────────────────────
# Crear cuenta en https://resend.com → API Keys → Create
# En el dominio remitente (CONTACT_FROM_EMAIL) tenés que verificar
# el dominio o usar el sandbox "onboarding@resend.dev" para probar.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx
CONTACT_FROM_EMAIL=Florencia <hola@tudominio.com>

# ── Modo de storage de Keystatic ──────────────────────────────────
# Si KEYSTATIC_GITHUB_APP_ID y KEYSTATIC_GITHUB_APP_PRIVATE_KEY están
# definidos, Keystatic usa storage: github (commitea al repo vía la
# GitHub App). Si no, usa storage: local (filesystem — sólo funciona
# en dev o en un host con filesystem escribible).
#
# Para crear la GitHub App: https://github.com/settings/apps/new
#   - Homepage URL: https://<tu-dominio>
#   - Callback URL: https://<tu-dominio>/api/keystatic/_auth/github/callback
#   - Webhook: desactivado
#   - Repository permissions: Contents (Read & write), Metadata (Read-only)
#   - Después de crearla, instalala en el repo.
#
# KEYSTATIC_GITHUB_APP_ID           = App ID (número)
# KEYSTATIC_GITHUB_APP_CLIENT_ID    = "Client ID" de la app
# KEYSTATIC_GITHUB_APP_CLIENT_SECRET = "Client secret" que generás
# KEYSTATIC_GITHUB_APP_PRIVATE_KEY  = contenido del .pem que descargás
#   (en Vercel: pegar el contenido con \n reemplazados por saltos reales)
# KEYSTATIC_GITHUB_REPO_OWNER       = tu usuario u org de GitHub
# KEYSTATIC_GITHUB_REPO_NAME        = nombre del repo
# KEYSTATIC_SECRET                  = string aleatorio de ≥32 caracteres
#   (en Vercel: openssl rand -hex 32)
