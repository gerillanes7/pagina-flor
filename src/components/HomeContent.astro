---
import Base from "../layouts/Base.astro";
import { listWorks, readStudio, readHomePanels } from "../lib/content";
import es from "../i18n/es.json";
import en from "../i18n/en.json";

const { locale } = Astro.props as { locale: "es" | "en" };
const t = locale === "es" ? es : en;

const all = await listWorks();
const pieceCount = all.length;
const pieceUnit = locale === "es" ? (pieceCount === 1 ? "pieza" : "piezas") : (pieceCount === 1 ? "piece" : "pieces");

const studio = await readStudio();
const homePanels = await readHomePanels();

const panelMeta: Record<string, { es: { tag: string; sub: string }; en: { tag: string; sub: string } }> = {
  obra: {
    es: { tag: "I · Obra", sub: `${pieceCount} ${pieceUnit}` },
    en: { tag: "I · Work", sub: `${pieceCount} ${pieceUnit}` },
  },
  carta: {
    es: { tag: "II · Carta", sub: "Carta del estudio" },
    en: { tag: "II · Letter", sub: "Letter from the studio" },
  },
  contacto: {
    es: { tag: "III · Contacto", sub: "Correo · Instagram · Visita" },
    en: { tag: "III · Contact", sub: "Email · Instagram · Visit" },
  },
};

const resolvePanel = (managed: string | null | undefined, fallback: string): string => {
  if (!managed) return fallback;
  if (/^(https?:)?\/\//.test(managed) || managed.startsWith("/")) return managed;
  return `/panels/${managed}`;
};

const panelObraSrc = resolvePanel(homePanels?.obraPanel, "/banners/obra-banner.svg");
const panelCartaSrc = resolvePanel(homePanels?.cartaPanel, "/banners/carta-banner.svg");
const panelContactoSrc = resolvePanel(homePanels?.contactoPanel, "/banners/contacto-banner.svg");

const today = new Date();
const dateStr = today.toLocaleDateString(locale === "es" ? "es-ES" : "en-GB", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const fallbackLetter = t.studio.letter as string[];
const para1 = studio?.intro?.[locale] || fallbackLetter[0];
const para2 = studio?.method?.[locale] || fallbackLetter[1];
const para3 = studio?.commissions?.[locale] || fallbackLetter[2];
const signature = studio?.signature?.trim() || t.studio.signature;

const paragraphs = [para1, para2, para3].filter(
  (p): p is string => typeof p === "string" && p.trim().length > 0
);
---

<Base locale={locale} t={t} bodyClass="page-home">
  <section class="container panels" aria-label={locale === "es" ? "Salas del estudio" : "Studio rooms"}>
    <a class="panel" href={`/${locale}/work/`} aria-label={locale === "es" ? "Obra — selección de pinturas" : "Work — selection of paintings"}>
      <img class="panel__media" src={panelObraSrc} alt="" />
      <span class="panel__scrim" aria-hidden="true"></span>
      <span class="panel__label" aria-hidden="true">
        <span>
          <span class="panel__mark">{locale === "es" ? "Obra" : "Work"}</span>
          <span class="panel__tag">{panelMeta.obra[locale].tag} · {panelMeta.obra[locale].sub}</span>
        </span>
      </span>
    </a>

    <a class="panel" href={`/${locale}/studio/`} aria-label={locale === "es" ? "Carta — sobre mí" : "Letter — about the painter"}>
      <img class="panel__media" src={panelCartaSrc} alt="" />
      <span class="panel__scrim" aria-hidden="true"></span>
      <span class="panel__label" aria-hidden="true">
        <span>
          <span class="panel__mark">{locale === "es" ? "Carta" : "Letter"}</span>
          <span class="panel__tag">{panelMeta.carta[locale].tag} · {panelMeta.carta[locale].sub}</span>
        </span>
      </span>
    </a>

    <a class="panel" href={`/${locale}/contact/`} aria-label={locale === "es" ? "Contacto — para adquisiciones y encargos" : "Contact — for acquisitions and commissions"}>
      <img class="panel__media" src={panelContactoSrc} alt="" />
      <span class="panel__scrim" aria-hidden="true"></span>
      <span class="panel__label" aria-hidden="true">
        <span>
          <span class="panel__mark">{locale === "es" ? "Contacto" : "Contact"}</span>
          <span class="panel__tag">{panelMeta.contacto[locale].tag} · {panelMeta.contacto[locale].sub}</span>
        </span>
      </span>
    </a>
  </section>

  <section class="about-home" aria-label={locale === "es" ? "Sobre mí" : "About the painter"}>
    <div class="container about-home__inner">
      <span class="about-home__side-l" aria-hidden="true">{locale === "es" ? "Estudio · Madrid" : "Studio · Madrid"}</span>

      <header class="about-home__head">
        <p class="about-home__eyebrow">{t.home.about.title}</p>
        <span class="about-home__rule" aria-hidden="true"></span>
        <h2 class="about-home__title">Florencia</h2>
        <p class="about-home__lead">{t.home.about.lead}</p>
      </header>

      <div class="about-home__body">
        {paragraphs.map((para) => (
          <p>{para}</p>
        ))}
        <p class="about-home__sign">— {signature}, {dateStr}</p>
      </div>

      <span class="about-home__side-r" aria-hidden="true">{locale === "es" ? "Pintura · Óleo · acrílico" : "Painting · Oil · acrylic"}</span>
    </div>
  </section>

  <section class="contact-home" aria-label={locale === "es" ? "Contacto" : "Contact"}>
    <div class="container contact-home__inner">
      <div class="contact-home__head">
        <p class="contact-home__eyebrow">{locale === "es" ? "III · Contacto" : "III · Contact"}</p>
        <h2 class="contact-home__title">{locale === "es" ? "Escríbele" : "Write to her"}</h2>
        <p class="contact-home__lead">{t.contact.lead}</p>

        <div class="contact-home__channels">
          <div>
            <span class="label">{t.contact.email}</span>
            <p style="margin: var(--space-2) 0 0;">
              <a href="mailto:florencia@florencia.example">florencia@florencia.example</a>
            </p>
          </div>
          <div>
            <span class="label">{t.contact.instagram}</span>
            <p style="margin: var(--space-2) 0 0;">
              <a href="https://instagram.com/florencia" rel="me noopener noreferrer" target="_blank">@florencia</a>
            </p>
          </div>
          <div>
            <span class="label">{t.contact.atelier}</span>
            <p class="muted" style="margin: var(--space-2) 0 0;">{t.contact.atelierValue}</p>
          </div>
        </div>
      </div>

      <div>
        <form
          action="mailto:florencia@florencia.example"
          method="post"
          enctype="text/plain"
          class="contact-home__form"
        >
          <h3 class="contact-home__form-title">{t.contact.formTitle}</h3>

          <label>
            <span class="label">{t.contact.formName}</span>
            <input type="text" name="name" required autocomplete="name" />
          </label>
          <label>
            <span class="label">{t.contact.formEmail}</span>
            <input type="email" name="email" required autocomplete="email" />
          </label>
          <label>
            <span class="label">{t.contact.formSubject}</span>
            <input type="text" name="subject" />
          </label>
          <label>
            <span class="label">{t.contact.formBody}</span>
            <textarea name="body" rows="6" required></textarea>
          </label>
          <p class="contact-home__submit-row">
            <button class="btn" type="submit">{t.contact.formSubmit}</button>
            <span class="contact-home__note">{t.contact.formNote}</span>
          </p>
        </form>
      </div>
    </div>
  </section>
</Base>
